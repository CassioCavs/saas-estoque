# -----------------------------------------------------------------------------
# EstoqueWise - Backend Environment Template
# Copy this file to `.env` and fill with real values.
# -----------------------------------------------------------------------------

# Environment
ENV=production

# Database (PostgreSQL / Supabase)
# Example: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg2://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DB

# JWT / Auth
# Generate a strong secret (at least 32 chars, recommended 64+)
# Example command (Python): import secrets; print(secrets.token_urlsafe(64))
SECRET_KEY=CHANGE_ME_WITH_A_STRONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated list of allowed frontend origins)
# Example: http://localhost:5173,https://app.seudominio.com
CORS_ORIGINS=http://localhost:5173

# AbacatePay Integration
ABACATEPAY_API_KEY=your_api_key_here
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v1

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Optional app settings
APP_NAME=EstoqueWise API
APP_DEBUG=false
